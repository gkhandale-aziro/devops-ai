# ── AI Model (pick one) ────────────────────────────────────────────────────────

# Local (no API key needed — requires Ollama running)
AI_MODEL=ollama/llama3.1:8b

# Two-model setup: fast model for tool calls, smart model for answers
# TOOL_MODEL=ollama/llama3.1:8b
# ANSWER_MODEL=ollama/gemma3

# Cloud models
# AI_MODEL=gpt-4o-mini
# AI_MODEL=claude-haiku-4-5-20251001
# AI_MODEL=gemini/gemini-2.0-flash

# ── API Keys (only needed for cloud models) ────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# MISTRAL_API_KEY=...

# ── AWS Bedrock ────────────────────────────────────────────────────────────────
# AWS_PROFILE=default
# AWS_DEFAULT_REGION=us-east-1

# ── Azure OpenAI ───────────────────────────────────────────────────────────────
# AZURE_API_KEY=...
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-02-01

# ── Sandbox mode ──────────────────────────────────────────────────────────────
# SANDBOX=safe      # default — whitelist of read-only commands only
# SANDBOX=local     # run all commands directly (no restriction)
# SANDBOX=docker    # run commands inside a Docker container
