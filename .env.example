# ═══════════════════════════════════════════════════════════════════════════════
# Aziro Ops — example environment file
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this to `.env` and uncomment the lines you need. Values shown are the
# built-in defaults unless noted otherwise. All AZIRO_* vars are optional in
# dev; production deployments should review every section before going live.
# ═══════════════════════════════════════════════════════════════════════════════


# ── Authentication mode ────────────────────────────────────────────────────────
# Which credential types the /api/ layer accepts:
#   apikey  — Bearer token (AZIRO_API_KEY). Default. Good for CLI/CI.
#   session — Flask-Login cookie from /api/v1/auth/login. Good for the UI.
#   both    — accept either.
# AZIRO_AUTH_MODE=apikey

# ── API key (apikey mode) ──────────────────────────────────────────────────────
# Bearer token required on all /api/ routes when AUTH_MODE is apikey or both.
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# When unset AND mode=apikey, auth is DISABLED (warned at boot — dev only).
# AZIRO_API_KEY=

# ── Session mode ───────────────────────────────────────────────────────────────
# Required when AUTH_MODE is session or both. Used to sign session cookies.
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# AZIRO_SESSION_SECRET=

# Bootstrap the first admin user on startup (only runs if users table is empty).
# Password must be ≥ AZIRO_MIN_PASSWORD_LEN chars.
# AZIRO_BOOTSTRAP_ADMIN_USER=admin
# AZIRO_BOOTSTRAP_ADMIN_PASSWORD=change-me-please-really

# ── Password policy & login lockout ────────────────────────────────────────────
# AZIRO_MIN_PASSWORD_LEN=12
# AZIRO_BCRYPT_ROUNDS=12
# AZIRO_LOGIN_FAIL_LIMIT=5           # failed logins before lockout
# AZIRO_LOGIN_FAIL_WINDOW=300        # sliding window (seconds)
# AZIRO_LOGIN_FAIL_LOCKOUT=900       # lockout duration (seconds)


# ── AI Model ──────────────────────────────────────────────────────────────────
# Pick ONE primary model. If quota exhausts, system auto-falls back to Ollama.

# Option A: Cloud model (recommended — fast, smart, auto-fallback to Ollama)
# AI_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=your-gemini-api-key-here

# Option B: Local only (no API key needed — requires Ollama running)
# AI_MODEL=ollama/qwen2.5:7b

# Option C: Two-model setup (fast tool calls + smart answers)
# TOOL_MODEL=gemini/gemini-2.5-flash
# ANSWER_MODEL=gemini/gemini-2.5-pro

# Other cloud models:
# AI_MODEL=gpt-4o-mini
# AI_MODEL=claude-haiku-4-5-20251001
# AI_MODEL=groq/llama-3.1-8b-instant

# ── Ollama Fallback (auto-detected, no config needed) ─────────────────────────
# When a cloud model hits quota/rate limits, system auto-discovers Ollama
# and switches to the best available local model (prefers qwen2.5:7b).
# Auto-retries primary every 5 min and switches back when quota resets.
#
# Docker: Ollama runs on the host, not inside the container.
# This tells LiteLLM where to find it:
# OLLAMA_API_BASE=http://host.docker.internal:11434
#
# Setup Ollama on host (Linux MUST bind 0.0.0.0 so Docker can reach it):
#   curl -fsSL https://ollama.ai/install.sh | sh
#   ollama pull qwen2.5:7b
#   sudo systemctl enable ollama
#   # edit /etc/systemd/system/ollama.service → Environment="OLLAMA_HOST=0.0.0.0:11434"

# ── API Keys (only needed for cloud models) ────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=...
# MISTRAL_API_KEY=...

# ── AWS Bedrock ────────────────────────────────────────────────────────────────
# AWS_PROFILE=default
# AWS_DEFAULT_REGION=us-east-1

# ── Azure OpenAI ───────────────────────────────────────────────────────────────
# AZURE_API_KEY=...
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-02-01


# ── Sandbox mode ──────────────────────────────────────────────────────────────
# SANDBOX=safe      # default — whitelist of read-only commands only
# SANDBOX=local     # run all commands directly (no restriction)
# SANDBOX=docker    # run commands inside a Docker container


# ── Network / TLS / CSRF ──────────────────────────────────────────────────────
# AZIRO_HOST=0.0.0.0
# AZIRO_PORT=5000

# Trust this many X-Forwarded-* hops. Set to 1 only when behind a reverse proxy
# you control (nginx, ALB). 0 means never trust forwarded headers — prevents
# spoofed client IPs from bypassing rate limits.
# AZIRO_PROXY_HOPS=0

# CSRF Origin/Referer check for session mode (CSV of allowed origins).
# Requests with a cross-origin Origin header are rejected.
# AZIRO_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Enable Strict-Transport-Security + mark cookies as Secure. Turn on ONLY when
# the site is reachable exclusively over HTTPS (breaks HTTP-only dev).
# AZIRO_ENABLE_HSTS=1

# Override the default Content-Security-Policy. Empty string disables CSP.
# AZIRO_CSP="default-src 'self'; ..."


# ── Rate limits (Flask-Limiter) ───────────────────────────────────────────────
# AZIRO_RATE_LIMIT=120/minute                  # default cap per-route/user
# AZIRO_CHAT_STREAM_LIMITS=10/minute;100/hour  # LLM chat + analyze endpoints
# AZIRO_LOGIN_LIMITS=10/minute;50/hour         # /auth/login brute-force cap

# Storage URI for limiter counters. "memory://" is per-worker (fine for 1-worker
# dev). Multi-worker gunicorn needs Redis so all workers share one counter:
# AZIRO_LIMITER_STORAGE=redis://redis:6379/1


# ── Request / payload caps ────────────────────────────────────────────────────
# AZIRO_MAX_BODY_MB=1               # per-request JSON body cap
# AZIRO_MAX_MESSAGE_CHARS=4000      # single chat message char cap


# ── Data directory & encryption key ───────────────────────────────────────────
# Where the SQLite DB, session store, and target secrets live. Container runs
# set this to /app/data (mounted volume).
# AZIRO_DATA_DIR=/app/data

# Path to the key file that encrypts stored target credentials.
# Defaults to $AZIRO_DATA_DIR/.aziro_key
# AZIRO_KEY_FILE=/app/data/.aziro_key


# ── Gunicorn tuning ───────────────────────────────────────────────────────────
# AZIRO_GUNICORN_WORKERS=2              # keep low — each worker handles many SSE
# AZIRO_GUNICORN_WORKER_CONNECTIONS=1000
# AZIRO_GUNICORN_TIMEOUT=120            # seconds — SSE streams need headroom
# AZIRO_GUNICORN_LOGLEVEL=info


# ── Logging ───────────────────────────────────────────────────────────────────
# AZIRO_LOG_LEVEL=INFO

# ── Observability stack (opt-in, `./obs-run.sh up`) ──────────────────────────
# obs-run.sh auto-sources this file, so any var below is picked up without
# needing `export` on the command line. Shell exports still take precedence.
#
# Host bind for Grafana + Loki ports. 127.0.0.1 = localhost only (use
# `ssh -L 3000:127.0.0.1:3000 <host>` to reach Grafana). 0.0.0.0 = reachable
# on all host interfaces — only do this on trusted networks AND with a strong
# GRAFANA_ADMIN_PASSWORD (obs-run.sh fail-closes otherwise).
# BIND_ADDR=127.0.0.1
# GRAFANA_PORT=3000
# LOKI_PORT=3100

# Grafana admin credentials. MUST be set before first ./obs-run.sh up in any
# shared environment. Leaving unset lets the script fall back to admin/admin
# and warn on startup — dev-laptop convenience only, not for VMs/prod.
# GRAFANA_ADMIN_USER=change-me
# GRAFANA_ADMIN_PASSWORD=change-me-before-first-start

# Prometheus scrape endpoint (opt-in, RUN-3). Defaults match obs-run.sh.
# PROM_PORT=9090

# Metrics endpoint auth. When unset, /metrics is open (fine for same-host
# scrape via docker DNS `aziro:5000`). When set, the app requires a matching
# Bearer token on /metrics — Prometheus scrape config must carry it too.
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# AZIRO_METRICS_TOKEN=

# Multi-process metric shard dir. docker-run.sh sets this so gunicorn workers
# write per-process metric shards here and /metrics aggregates them. Only
# change if the default is unavailable (e.g. read-only rootfs).
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
